# Odvisnosti
node_modules/

# Lokalna baza teka (hermes) in njeni WAL/SHM sopotniki.
# Osnovno ime nastavlja .env.example (LEDGER_DB); privzeto je .gstack-run.sqlite.
.gstack-run.sqlite
.gstack-run.sqlite-shm
.gstack-run.sqlite-wal

# Producirani artefakti teka (npr. out/RESULT.md, out/PLAN.md, app/, demo/).
# Na novo jih generira tek; v repot ne spadajo.
out/*
app/
demo/
diagrams/

# Dashboard je NAMEREN izdelek (ročno napisana aplikacija), ne produciran
# artefakt teka — zato ga z izjemo vključimo izven out/* ignoriranja.
!out/Dashboard.html

# Razvojni grader in helper
*.tsbuildinfo
.gstack/

# Skrivnosti / lokalna konfiguracija (nikoli commit-aj API klucev)
.env
.env.local
*.local
client_secret.json
# Google OAuth token (shranjen po avtorizaciji) — občutljivo
.gtoken.json

# Python (sodelavec / .rob_ai)
venv/
engine/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# RSI runtime buildi (dashboard naloge) — ne v verzioniranje.
# (2026-08-28: pravilo actions/*/ ODSTRANJENO — P9 fleet sinhronizira workerjeve
#  build-e na master in v git; novi moduli se zdaj commitajo ob rob fleet backup.)

# Runtime stanje podjetja (generirano, izven gita)
.rob_ai/agenda.json
.rob_ai/daemon.json
.rob_ai/daemon.lock
.rob_ai/daemon.stop
.rob_ai/*.log
.rob_ai/*.tmp
.rob_ai/fleet_workers.json
.rob_ai/*.json.tmp
.rob_ai/business_ledger.json
.rob_ai/audit.jsonl
.rob_ai/eval_history.json
.rob_ai/.visual_qa_tmp.png
.rob_ai/gmail_cursor.json

# Baze podatkov in lokalno stanje (Rob AI Studio)
.rob_ai/memory.db
.rob_ai/memory.db-shm
.rob_ai/memory.db-wal
.rob_ai/graph.json
.loopx/
.DS_Store

# P5 eval izzivi — runtime artefakti, ki jih ustvari evaluate_autonomy.py
# (niso producijski moduli; arhivirani v legacy/)
legacy/fizzbuzz/
legacy/divide_safe/
legacy/count_words/
# P5 eval lestvica — runtime moduli zgrajeni v actions/ (niso producijski)
actions/fizzbuzz/
actions/divide_safe/
actions/count_words/
actions/text_stats/
actions/money_formatter/
actions/order_schema/
actions/inventory_api/
actions/growth_report/
# P0 real eval — bugfix kopije zlatih modulov (SWE-bench stil, generirane ob eval teku)
actions/fix_*/
.rob_ai/eval_report.md
# Runtime test build-i iz klikov (trajna agenda / testne naloge) — izven gita
legacy/test/
legacy/testna/

# Self-signed TLS cert (lokalno generiran — NE commitaj privatnega ključa)
certs/
.rob_ai/research/
