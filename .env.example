# Kateri ponudnik se uporabi za zive teke. Privzeto 'ollama', ker tece lokalno
# in ne potrebuje kljuca. Glej src/bridges/provider.ts za register.
#   ollama   | lokalno, brez kljuca, brez stroskov
#   openai   | zahteva OPENAI_API_KEY
#   deepseek | zahteva DEEPSEEK_API_KEY
LLM_PROVIDER=deepseek

# Neobvezno. Ce ni nastavljen, se uporabi privzeti model ponudnika.
# LLM_MODEL=llama3.2:3b

# Kljuci. Ollama jih ne potrebuje.
# Zamenjaj s pravim kljucem za svojega ponudnika (NE commit-aj realnega)
# in nastavi ga v lokalno .env datoteko.
# OPENAI_API_KEY=sk-REPLACE_ME
# DEEPSEEK_API_KEY=sk-REPLACE_ME

# Neobvezna preglasitev baznega naslova, na primer za lokalni proxy.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Pot do dnevnika. Privzeto .gstack-run.sqlite v korenu projekta.
# LEDGER_DB=.gstack-run.sqlite

# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_CHAT=deepseek-chat
# DEEPSEEK_MODEL_CODER=deepseek-coder

# ─── produktni generator (izvajanje programa skozi qa) ──────────────────────
# Brez teh nista privzeta: runner poganja `cmd.exec` skozi allowlist (DEFAULT_EXEC_ALLOW).
# Prekršitelja v allowlist ali pot izven korena runner zavrne z EACCES.

# Neobvezen preglasek allowlista (cela prezivjena). Zamenja privzeti DEFAULT_EXEC_ALLOW.
# EXEC_ALLOW=bun,node,npx,echo,true

# Koren izvajanja (cwd): izven te poti ukazom ni dovoljeno izvajati. Privzeto '.'.
# EXEC_CWD_ROOT=.
