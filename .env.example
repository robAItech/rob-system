# Kateri ponudnik se uporabi za zive teke. Privzeto 'deepseek' (glavni LLM
# sistema). Glej src/bridges/provider.ts za register.
#   deepseek | zahteva DEEPSEEK_API_KEY (privzeto)
#   ollama   | lokalno, brez kljuca, brez stroskov
#   openai   | zahteva OPENAI_API_KEY
LLM_PROVIDER=deepseek

# Neobvezno. Ce ni nastavljen, se uporabi privzeti model ponudnika.
# LLM_MODEL=llama3.2:3b

# Kljuci. Kopiraj predlogo v lokalno .env (cp .env.example .env) in zamenjaj
# placeholderje s pravimi kljuci (NE commit-aj realnega kljuca).

# Obvezen — glavni LLM (RSI zanka, daemon, eval). Placeholder je usklajen s
# CI-jem (.github/workflows/ci.yml skoci eval, ce kljuca ni ali je ta placeholder).
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Opcijsko — semantični spomin (embeddingi) + TTS + spletno iskanje.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=REPLACE_ME

# Opcijsko — pravo Google iskanje. https://serper.dev
SERPER_API_KEY=REPLACE_ME

# Neobvezna preglasitev baznega naslova, na primer za lokalni proxy.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Pot do dnevnika. Privzeto .gstack-run.sqlite v korenu projekta.
# LEDGER_DB=.gstack-run.sqlite

# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_CHAT=deepseek-chat
# DEEPSEEK_MODEL_CODER=deepseek-coder
# Vizija (eksperimentalno): screenshot → HTML/analiza. Cena = navadni flash.
# DEEPSEEK_MODEL_VISION=deepseek-v4-flash-vision-exp

# Agentic tool-use v RSI heal zanki (OpenAI function-calling: read_file/write_file/
# list_files/search_memory). LLM lahko iterira z orodji, nato vrne končni odgovor.
# false = tekstovna pot (### FILE:) — za pred/po primerjavo ali off-switch.
LLM_TOOL_USE=true

# Semantični spomin (korak 2) — embeddingi prek Gemini za iskanje podobnosti.
# Gemini se uporablja SAMO za embedContent (vektorji spomina); DeepSeek ostaja
# glavni LLM. GEMINI_API_KEY se že uporablja za TTS/iskanje v server.ts.
# GEMINI_API_KEY=REPLACE_ME
# MEMORY_EMBEDDINGS=true
# MEMORY_EMBED_MODEL=gemini-embedding-2
# MEMORY_EMBED_API=gemini
# MEMORY_EMBED_TIMEOUT=10

# GStack skilli kot LLM orodje (korak 6). Privzeto ~/.claude/skills/.
# Opcijska preglasitev poti do korena skillov (za CI/izolacijo).
# GSTACK_SKILLS_DIR=

# ─── Kontekst upravljanje (korak 3) ────────────────────────────────────────
# Izhodni cap LLM v tokenih. PRAZNO = neomejeno (varno za heal, ki piše cele
# datoteke). Če nastaviš, izberi >= velikost največje datoteke, ki jo heal vrača.
# LLM_MAX_COMPLETION_TOKENS=
# Maks. skupna dolžina heal prompta (znaki).
LLM_HEAL_PROMPT_CHARS=50000
# Maks. del sources (koda modula) v heal promptu (znaki).
LLM_HEAL_SOURCES_CHARS=24000
# true = v sources tudi test datoteke (test_*.py, *_test.py, conftest.py).
# Priporočeno false: LLM jih ne sme spreminjati (Test-Locking), hkrati ~55 %
# manj tokenov. Nastavi true le, če heal ne zadane testnega kontrakta.
LLM_HEAL_INCLUDE_TESTS=false
# Maks. skupna dolžina messages v agentic heal zanki (trim praga).
LLM_HEAL_AGENTIC_CONTEXT_CHARS=50000

# Korak 10 — avto-rollback ob neuspelem buildu. false = zlomljena koda ostane.
LOOPX_ROLLBACK_ON_FAIL=true

# P2 — plan-time kontekst: načrtovalci (task_planner, team, run_autonomous)
# dobijo pretekle lekcije + world-model napoved v prompt (core/plan_context.py).
LLM_PLAN_CONTEXT=true

# ─── produktni generator (izvajanje programa skozi qa) ──────────────────────
# Brez teh nista privzeta: runner poganja `cmd.exec` skozi allowlist (DEFAULT_EXEC_ALLOW).
# Prekršitelja v allowlist ali pot izven korena runner zavrne z EACCES.

# Neobvezen preglasek allowlista (cela prezivjena). Zamenja privzeti DEFAULT_EXEC_ALLOW.
# EXEC_ALLOW=bun,node,npx,echo,true

# Koren izvajanja (cwd): izven te poti ukazom ni dovoljeno izvajati. Privzeto '.'.
# EXEC_CWD_ROOT=.
# Rezerva, ko DeepSeek pade (OpenRouter, OpenAI-kompatibilen)
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# ─── Daemon (P1, 24/7 master proces) ────────────────────────────────────────
# Vse spodnje ima privzete vrednosti v core/config.py — nastavi le, če
# privzeto želiš spremeniti. Poln seznam najdeš s `grep "alias=\"DAEMON_" core/config.py`.
# Idle interval med ticki (sekund).
# DAEMON_IDLE_SECONDS=5
# Heartbeat zapis v .rob_ai/daemon.json (sekund).
# DAEMON_HEARTBEAT_SECONDS=30
# Ponovni poskus dviga proxyja, če ni dosegljiv (sekund).
# DAEMON_PROXY_RETRY_SECONDS=60
# Trdi timeout ene naloge iz agende (sekund).
# DAEMON_TASK_TIMEOUT_SECONDS=1800
# Število vzporednih delavcev (subprocesov run_swarm.py).
# DAEMON_WORKERS=2
# Interval vzdrževalnih jobov (ure): konsolidacija spomina / refleksija /
# samorazvoj / meta-eval / poln eval / predlogi ciljev. 0 = onemogoči.
# DAEMON_CONSOLIDATE_HOURS=24
# DAEMON_REFLECT_HOURS=168
# DAEMON_IMPROVE_HOURS=168
# DAEMON_META_CHECK_HOURS=168
# DAEMON_FULL_EVAL_HOURS=168
# DAEMON_GOAL_HOURS=6
# Omejitve predlaganih nalog iz goal autonomy.
# DAEMON_GOAL_MAX_ENQUEUE=2
# DAEMON_GOAL_PENDING_CAP=3
# Varnostni prag prostega diska (GB) — daemon se ustavi pod njim.
# DAEMON_MIN_FREE_GB=2.0

# ─── Avtonomija: tedenski readout + kvalitetni prag ────────────────────────
# Tedenski readout (`rob report`): vsi izvedeni taski + kvaliteta + eval +
# fleet → .rob_ai/weekly_report.md. 0 = izključeno.
# REPORT_HOURS=168
# Kvalitetni prag (`rob quality --gate`): daily označi targete z nizko
# uspešnostjo kot disabled + zapiše eskalacijo (dashboard feed). 0 = izključeno.
# QUALITY_GATE_HOURS=24
# Koliko tekov mora imeti target preden ga sodimo (izogib obsojanju enega teka).
# QUALITY_MIN_RUNS=3
# Prag uspešnosti (green/runs), pod katerim se target označi kot disabled.
# QUALITY_MIN_SUCCESS_RATE=0.5
# "Milost" po re-enable: gate ne flag-a targeta znova na podlagi stare
# zgodovine, dokler ne poteče (dni).
# QUALITY_REENABLE_GRACE_DAYS=7

# ─── Agent swarm (team) — avtomatska izbira ────────────────────────────────
# Daemon sam odloči, kdaj naloga uporabi multi-agent tim (plan→critique→
# build→verify) namesto enojnega RSI — brez vnosa. false = vedno single.
# TEAM_AUTO_ENABLED=true
# Vejice-ločen seznam kind-ov, ki avtomatsko dobijo team. Privzeto
# 'autonomous' (goal_autonomy kompleksne naloge). Dokumentne naloge
# (doc-guard) ostanejo single/run_autonomous.
# TEAM_AUTO_KINDS=autonomous
# Retry zanka v team buildu: koliko poskusov, preden verify pade → eskalacija.
# TEAM_MAX_ATTEMPTS=3

# ─── P9 — master–worker fleet (deljena agenda čez več strojev) ─────────────
# Kako ta stroj sodeluje v floti:
#   standalone (privzeto)  — današnje vedenje, nič se ne spremeni
#   master                 — dela + služi agendo workerjem prek /fleet/*
#   worker                 — potegne naloge od masterja, izvede lokalno
#                            (run_swarm --item), pošlje rezultat nazaj
# ROB_FLEET_ROLE=standalone
# URL masterjevega fleet strežnika (worker). Nikoli javni internet — Tailscale.
# ROB_FLEET_MASTER_URL=http://127.0.0.1:8789
# Skupna skrivnost (OBVEZNA za master in worker; fail-closed brez nje).
# ROB_FLEET_TOKEN=zamenjaj-me
# Port masterjevega fleet strežnika (`rob fleet serve`).
# ROB_FLEET_PORT=8789
# Lease TTL: po koliko sekundah master sprosti nalogo, če worker umre sredi nje.
# ROB_FLEET_CLAIM_TTL_SECONDS=1800
# Faza 4 — deljen spomin: worker pred nalogo potegne masterjev spomin, po nalogi
# pošlje svoje nove lekcije nazaj (agregacija). false = samo deljena agenda.
# ROB_FLEET_SYNC_MEMORY=true
# Periodični sync spomina: worker 1×/uro (le ko je master dosegljiv) izmenja
# spomin + heartbeat. 0 = izključeno (le ob nalogah).
# ROB_FLEET_MEMORY_SYNC_SECONDS=3600
# Backoff: ko master ni dosegljiv, worker NE išče povezave — počaka ta čas
# pred naslednjim poskusom. 300 = 5 min (hitro okrevanje).
# ROB_FLEET_BACKOFF_SECONDS=300
# Avtomatski git backup na masterju (spomin+agenda → fleet/backup.json →
# commit+push). 0 = izključeno (le ročno `rob fleet backup`).
# ROB_FLEET_BACKUP_SECONDS=3600
# Avtomatski git sync (master IN worker): `git pull --rebase --autostash`
# izmenja kodo brez ročnega posega. 0 = izključeno.
# ROB_FLEET_GIT_SYNC_SECONDS=3600
# Odpornost (ročno): `rob fleet backup` na masterju, `rob fleet restore` kjerkoli.

# ─── Alternativni/nadomestni LLM (zadnja rezerva v fallback verigi) ─────────
# Po izčrpanju DeepSeek + OpenRouter se poskusi ta model (npr. glm-5.3-flash:cloud).
# Ime modela; prazno = onemogočeno.
# ALTERNATE_MODEL=
# Opcijsko: lasten base_url/key za alternativni model. Prazno → OpenRouter
# (če je OPENROUTER_API_KEY nastavljen), sicer DeepSeek base.
# ALTERNATE_BASE_URL=
# ALTERNATE_API_KEY=
