# Kateri ponudnik se uporabi za zive teke. Privzeto 'ollama', ker tece lokalno
# in ne potrebuje kljuca. Glej src/bridges/provider.ts za register.
#   ollama   | lokalno, brez kljuca, brez stroskov
#   openai   | zahteva OPENAI_API_KEY
#   deepseek | zahteva DEEPSEEK_API_KEY
LLM_PROVIDER=deepseek

# Neobvezno. Ce ni nastavljen, se uporabi privzeti model ponudnika.
# LLM_MODEL=llama3.2:3b

# Kljuci. Kopiraj predlogo v lokalno .env (cp .env.example .env) in zamenjaj
# placeholderje s pravimi kljuci (NE commit-aj realnega kljuca).

# Obvezen — glavni LLM (RSI zanka, daemon, eval). Placeholder je usklajen s
# CI-jem (.github/workflows/ci.yml skoci eval, ce kljuca ni ali je ta placeholder).
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Opcijsko — semantični spomin (embeddingi) + TTS + spletno iskanje.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=REPLACE_ME

# Opcijsko — pravo Google iskanje. https://serper.dev
SERPER_API_KEY=REPLACE_ME

# Neobvezna preglasitev baznega naslova, na primer za lokalni proxy.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Pot do dnevnika. Privzeto .gstack-run.sqlite v korenu projekta.
# LEDGER_DB=.gstack-run.sqlite

# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_CHAT=deepseek-chat
# DEEPSEEK_MODEL_CODER=deepseek-coder

# Agentic tool-use v RSI heal zanki (OpenAI function-calling: read_file/write_file/
# list_files/search_memory). LLM lahko iterira z orodji, nato vrne končni odgovor.
# false = tekstovna pot (### FILE:) — za pred/po primerjavo ali off-switch.
LLM_TOOL_USE=true

# Semantični spomin (korak 2) — embeddingi prek Gemini za iskanje podobnosti.
# Gemini se uporablja SAMO za embedContent (vektorji spomina); DeepSeek ostaja
# glavni LLM. GEMINI_API_KEY se že uporablja za TTS/iskanje v server.ts.
# GEMINI_API_KEY=REPLACE_ME
# MEMORY_EMBEDDINGS=true
# MEMORY_EMBED_MODEL=gemini-embedding-2
# MEMORY_EMBED_API=gemini
# MEMORY_EMBED_TIMEOUT=10

# GStack skilli kot LLM orodje (korak 6). Privzeto ~/.claude/skills/.
# Opcijska preglasitev poti do korena skillov (za CI/izolacijo).
# GSTACK_SKILLS_DIR=

# ─── Kontekst upravljanje (korak 3) ────────────────────────────────────────
# Izhodni cap LLM v tokenih. PRAZNO = neomejeno (varno za heal, ki piše cele
# datoteke). Če nastaviš, izberi >= velikost največje datoteke, ki jo heal vrača.
# LLM_MAX_COMPLETION_TOKENS=
# Maks. skupna dolžina heal prompta (znaki).
LLM_HEAL_PROMPT_CHARS=50000
# Maks. del sources (koda modula) v heal promptu (znaki).
LLM_HEAL_SOURCES_CHARS=24000
# true = v sources tudi test datoteke (test_*.py, *_test.py, conftest.py).
# Priporočeno false: LLM jih ne sme spreminjati (Test-Locking), hkrati ~55 %
# manj tokenov. Nastavi true le, če heal ne zadane testnega kontrakta.
LLM_HEAL_INCLUDE_TESTS=false
# Maks. skupna dolžina messages v agentic heal zanki (trim praga).
LLM_HEAL_AGENTIC_CONTEXT_CHARS=50000

# Korak 10 — avto-rollback ob neuspelem buildu. false = zlomljena koda ostane.
LOOPX_ROLLBACK_ON_FAIL=true

# P2 — plan-time kontekst: načrtovalci (task_planner, team, run_autonomous)
# dobijo pretekle lekcije + world-model napoved v prompt (core/plan_context.py).
LLM_PLAN_CONTEXT=true

# ─── produktni generator (izvajanje programa skozi qa) ──────────────────────
# Brez teh nista privzeta: runner poganja `cmd.exec` skozi allowlist (DEFAULT_EXEC_ALLOW).
# Prekršitelja v allowlist ali pot izven korena runner zavrne z EACCES.

# Neobvezen preglasek allowlista (cela prezivjena). Zamenja privzeti DEFAULT_EXEC_ALLOW.
# EXEC_ALLOW=bun,node,npx,echo,true

# Koren izvajanja (cwd): izven te poti ukazom ni dovoljeno izvajati. Privzeto '.'.
# EXEC_CWD_ROOT=.
# Rezerva, ko DeepSeek pade (OpenRouter, OpenAI-kompatibilen)
OPENROUTER_API_KEY=sk-or-your-openrouter-key
