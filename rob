#!/usr/bin/env bash
set -e

# Repo koren = direktorij te skripte (deluje na Windows/Git Bash in WSL/Linux),
# ne trdo-kodirana pot. To je potrebno za `rob dev`, ki zažene bun iz korena.
PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Aktiviraj venv, če obstaja; sicer uporabi sistemski python (fallback).
# Odporno na to, KATERI bash poganja skripto (Git Bash ali WSL):
# - Windows venv: Scripts/python(.exe), POSIX venv: bin/python.
# - Ime je lahko `venv` ali `engine` (obe se pojavljata v tem repoju).
# - NE zanašamo se na `source activate` — Windows venv skripta je CRLF in v
#   WSL razbije; namesto tega python() kaže direktno na venv python.exe, njen
#   Scripts/bin pa damo na PATH (da `rob dev` najde litellm).
# - Brez venv-a: poskusi `py -3` (Windows launcher), nato obstoječi
#   python/python3 — s POZORILOM, da ne bo nejasnih napak.
_venv_python() {
    local dir sub cand
    for dir in venv engine; do
        for sub in Scripts bin; do
            for cand in python python.exe; do
                if [ -x "$PROJECT_DIR/$dir/$sub/$cand" ]; then
                    printf '%s\n' "$PROJECT_DIR/$dir/$sub/$cand"
                    return 0
                fi
            done
        done
    done
    return 1
}

activate_venv() {
    local venv_py
    venv_py="$(_venv_python)" || true
    if [ -n "$venv_py" ]; then
        export PATH="$(dirname "$venv_py"):$PATH"
        python() { "$venv_py" "$@"; }
        return 0
    fi
    if ! command -v python >/dev/null 2>&1; then
        echo "[rob] OPOZORILO: ni najdenega venv-a (venv|engine); uporabljam sistemski python." >&2
        if command -v py >/dev/null 2>&1; then
            python() { py -3 "$@"; }
        elif command -v python3 >/dev/null 2>&1; then
            python() { python3 "$@"; }
        fi
    fi
    return 0
}

# Razreši python (venv | sistem) ENKRAT na začetku — tako tudi načini brez
# lastnega activate_venv klica (dev, eval, build, ...) uporabijo pravi python.
# Brez venv-a je to no-op (sistemski python na PATH). Idempotentno.
activate_venv

if [ "$1" == "up" ]; then
    cd "$PROJECT_DIR" && docker-compose up -d --build
elif [ "$1" == "down" ]; then
    cd "$PROJECT_DIR" && docker-compose down
elif [ "$1" == "test" ]; then
    cd "$PROJECT_DIR" && activate_venv && python -m pytest tests/
elif [ "$1" == "dashboard" ]; then
    cd "$PROJECT_DIR" && activate_venv && python core/dashboard_tui.py
elif [ "$1" == "review" ]; then
    cd "$PROJECT_DIR" && activate_venv && python core/system_self_check.py
elif [ "$1" == "build" ]; then
    if [ -z "$2" ] || [ -z "$3" ]; then
        echo "Uporaba: ./rob build <target> \"<directive>\""
        exit 1
    fi
    cd "$PROJECT_DIR" && activate_venv && python run_swarm.py --target "$2" --directive "$3"
elif [ "$1" == "dev" ]; then
    # P4 orkestracija (proxy :4010 + dashboard :8787 + claude). Python je
    # razrešen na vrhu skripte (venv | system); dev_cli.py kliče litellm/bun/
    # claude prek subprocess (morajo biti na PATH — venv Scripts že je).
    cd "$PROJECT_DIR" && python core/dev_cli.py "${@:2}"
elif [ "$1" == "eval" ]; then
    # P5 — SWE-bench stila samo-eval za avtonomnost RSI-GStack.
    cd "$PROJECT_DIR" && python evaluate_autonomy.py "${@:2}"
elif [ "$1" == "visual-qa" ]; then
    # Neobvezen vizualni QA — Gemma 4 (Ollama) pogleda HTML sliko.
    cd "$PROJECT_DIR" && python run_swarm.py --visual-qa "${@:2}"
elif [ "$1" == "consolidate" ]; then
    # Zanka 1 — spominska konsolidacija: surove epizode → semantične lekcije.
    cd "$PROJECT_DIR" && python core/memory_consolidation.py --run "${@:2}"
elif [ "$1" == "improve" ]; then
    # Zanka 3 — samorazvoj orkestracije: predlog → guard → test → promocija.
    cd "$PROJECT_DIR" && python core/self_improve.py --run "${@:2}"
elif [ "$1" == "tune" ]; then
    # Zanka 3 (globlje) — samorazvojno uglaševanje parametrov (max_attempts, prag).
    cd "$PROJECT_DIR" && python core/self_improve.py --tune "${@:2}"
elif [ "$1" == "meta" ]; then
    # Zanka 4 — meta-evalvacija: trenutne metrike uspešnosti.
    cd "$PROJECT_DIR" && python core/meta_eval.py --metrics "${@:2}"
elif [ "$1" == "plan" ]; then
    # Zanka 5 — dekompozicija cilja na podcilje (prikaz korakov).
    cd "$PROJECT_DIR" && python core/task_planner.py --decompose "$2"
elif [ "$1" == "team" ]; then
    # Zanka 6 — multi-agent adversarial koordinacija (plan → critique → build → verify).
    cd "$PROJECT_DIR" && python core/team.py --run "$2" --project "${3:-demo}"
elif [ "$1" == "predict" ]; then
    # Zanka 7 — svetovni model: napoved izida (uspešnost, LLM strošek, vzrok).
    cd "$PROJECT_DIR" && python core/world_model.py --predict "$2" --project "${3:-}"
elif [ "$1" == "fork" ]; then
    # Zanka 8 — paralelno raziskovanje pristopov (fork).
    cd "$PROJECT_DIR" && python core/fork.py --explore "$2" --project "${3:-}"
elif [ "$1" == "rlaif" ]; then
    # Zanka 9 — učenje preferenc: statistika / izvoz podatkov za fine-tuning.
    cd "$PROJECT_DIR" && python core/rlaif.py --stats
elif [ "$1" == "goals" ]; then
    # Zanka 10 — avtonomija ciljev: predlagaj naslednje naloge.
    cd "$PROJECT_DIR" && python core/goal_autonomy.py --propose
elif [ "$1" == "reflect" ]; then
    # P3 — strateška samorefleksija: operativna načela iz zadnjih lekcij.
    cd "$PROJECT_DIR" && python core/strategy_reflect.py "${@:2}"
elif [ "$1" == "patterns" ]; then
    # P5 — prečni vzorci neuspehov čez naloge (≥2 projektov).
    cd "$PROJECT_DIR" && python core/pattern_detect.py --patterns "${@:2}"
elif [ "$1" == "learn" ]; then
    # P7 — learning dashboard: eval trend + lekcije + načela + vzorci.
    cd "$PROJECT_DIR" && python core/learning_dashboard.py "${@:2}"
elif [ "$1" == "daemon" ]; then
    # P1 — avtonomni daemon (24/7): agendo prazni, sam predlaga naloge,
    # teče periodične jobe, piše heartbeat. --once/--status/--stop/--serve.
    cd "$PROJECT_DIR" && python core/daemon.py "${@:2}"
elif [ "$1" == "deploy" ]; then
    # Zagon python skripte, ki naredi POST request na naš novi manager
    cd "$PROJECT_DIR" && activate_venv && python -c "
import requests
try:
    # Manager bi načeloma moral teči, če je swarm up. Če ni, ga zaženemo manualno s kodo iz managerja
    from actions.deployment_manager.deployment_manager import DeploymentManager
    import asyncio
    
    async def run():
        mgr = DeploymentManager()
        print('⚙️ Generiram docker-compose.yml...')
        mgr.generate_docker_compose()
        print('⚙️ Posodabljam API Gateway route...')
        mgr.update_gateway_routes()
        print('🚀 Zaganjam Docker Deployment v ozadju...')
        await mgr.run_deployment()
        print('✅ SISTEM USPEŠNO DEPLOYAN V DOCKER.')
    
    asyncio.run(run())
except Exception as e:
    print(f'❌ Napaka pri deploymentu: {e}')
"
else
    echo "🤖 ROB AI STUDIO CLI"
    echo "Uporaba:"
    echo "  ./rob test        - Požene vse master teste"
    echo "  ./rob dashboard   - Odpre Live TUI Dashboard"
    echo "  ./rob review      - Požene LLM arhitekturno revizijo"
    echo "  ./rob up          - Zažene celoten ekosistem v Dockerju"
    echo "  ./rob down        - Zaustavi Docker ekosistem"
    echo "  ./rob build <mod> \"<navodilo>\" - Avtonomno zgradi nov modul"
    echo "  ./rob deploy      - Avtomatsko popravi docker-compose, Gateway in dvigne kontejnerje"
    echo "  ./rob dev         - Terminal/rescue: proxy + dashboard + claude (ročni nadzor)."
    echo "  ./rob dev --serve - AVTONOMEN zagon: system v ozadju (Task Scheduler), UI vnos, brez terminala."
    echo "  ./rob eval        - SWE-bench stila samo-eval avtonomnosti (P5; --dry-run za brez LLM preverbo)"
    echo "  ./rob visual-qa <pot|url> - Neobvezen vizualni QA (Gemma 4 prek Ollama pogleda HTML)"
    echo "  ./rob patterns    - P5: prečni vzorci neuspehov (≥2 projektov)"
    echo "  ./rob learn       - P7: learning dashboard (eval trend, lekcije, načela, vzorci)"
    echo "  ./rob daemon      - P1: avtonomni daemon 24/7 (--once/--status/--stop/--serve)"
fi
